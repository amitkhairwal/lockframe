{
  "name": "lockframe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env apps/api/src/index.ts",
    "start": "tsx --env-file-if-exists=.env apps/api/src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "test": "vitest run",
    "web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "upload:check": "tsx scripts/upload-check.ts",
    "bucket:setup": "tsx --env-file-if-exists=.env scripts/bucket-setup.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "worker": "tsx --env-file-if-exists=.env apps/worker/src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cookie": "^11.1.5",
    "@fontsource-variable/inter": "^5.3.0",
    "bullmq": "^6.5.1",
    "cookie": "^2.0.1",
    "fastify": "^5.12.7",
    "hls.js": "^1.7.4",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "mongodb": "^7.7.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "mongodb-memory-server": "^11.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.0"
  }
}
